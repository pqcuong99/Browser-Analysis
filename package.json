{
  "name": "sentinelfp",
  "version": "1.0.0",
  "private": true,
  "description": "SentinelFP: phân tích browser fingerprint, chấm điểm rủi ro 54 rule và chặn trình duyệt Antidetect",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "vite build",
    "prestart": "vite build",
    "start": "node server/index.ts",
    "dev": "node --watch server/index.ts",
    "dev:web": "vite",
    "test": "node --test \"test/**/*.test.ts\"",
    "simulate": "node scripts/simulate.ts",
    "mock": "node scripts/make-mock.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "fastify": "^5.12.8",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.6"
  }
}
